# --- YouTube ---
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_API_KEY=
# Video ID of the active live broadcast (from its watch URL) — needed by the director
YOUTUBE_VIDEO_ID=

# --- Video generation ---
# fal | replicate | mock
VIDEO_PROVIDER=mock
FAL_KEY=
# fal model endpoint (any text-to-video model on fal)
FAL_MODEL=fal-ai/minimax/hailuo-02/standard/text-to-video
REPLICATE_API_TOKEN=
REPLICATE_MODEL=minimax/video-01

# --- Behavior ---
CLIP_SECONDS=6
ROUND_SECONDS=60
QUEUE_DIR=clips/queue
PLAYED_DIR=clips/played
MIN_QUEUE=2
MAX_QUEUE=6
STREAM_RESOLUTION=1280x720
STREAM_FPS=30
